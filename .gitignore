# Security - Never commit secrets
config/secrets.php

# Separate application, tracked in its own repo:
# https://github.com/jtbnz/work_track
work_track/

# Runtime state - image display order, rebuilt by Database::syncWithDirectory()
data/

# Admin-managed client photos (hundreds of MB, uploaded via admin.php)
images/examples/*
!images/examples/.gitkeep
!images/examples/.htaccess


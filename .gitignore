.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log

# Temporary files
*.tmp
*.temp

# Backup files
*.bak
*.backup

# Cache files
cache/
*.cache

# Local archives (e.g. zipping assets to send to a supplier)
*.zip
